# 复制为 .env 后填真实值。.env 永远不要 commit。

# === 应用 ===
APP_NAME="StudyHub"
ENV=local
DEBUG=true
LOG_LEVEL=DEBUG

# === 数据库（M0-M4 SQLite；M5 起切 PG）===
# SQLite：相对 backend/ 目录
DATABASE_URL="sqlite+aiosqlite:///./data/studyhub.db"
# PG（M5+ 启用）：
# DATABASE_URL="postgresql+asyncpg://studyhub:PASSWORD@127.0.0.1:5432/studyhub"

# === 认证 ===
# 32 位随机：openssl rand -hex 16 或 python -c "import secrets; print(secrets.token_hex(16))"
AUTH_TOKEN=
AUTH_TOKEN_HEADER="X-Auth-Token"

# === AI 接入（M3 启用）===
# 走 OpenAI 兼容协议，切换厂商只改 base_url + model
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_API_KEY=
LLM_MODEL_PLAN="deepseek-chat"           # 计划生成（贵）
LLM_MODEL_QA="deepseek-chat"             # 问答/摘要（中）
LLM_MODEL_CARD="qwen-turbo"             # 出卡（便宜）
# SiliconFlow embedding
EMBEDDING_BASE_URL="https://api.siliconflow.cn/v1"
EMBEDDING_API_KEY=
EMBEDDING_MODEL="BAAI/bge-m3"

# === CORS ===
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
